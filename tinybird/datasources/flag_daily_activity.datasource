DESCRIPTION >
    Aggregated daily counts. No APPEND token: only the materialised view
    `flag_daily_activity_mv` writes here. Sorting key leads with `flag_key`
    because every safety pipe filters by flag first.

SCHEMA >
    `day` Date `json:$.day`,
    `flag_key` String `json:$.flag_key`,
    `app` LowCardinality(String) `json:$.app`,
    `build_id` String `json:$.build_id`,
    `outcome` LowCardinality(String) `json:$.outcome`,
    `variation` String `json:$.variation`,
    `event_count` UInt64 `json:$.event_count`

ENGINE "SummingMergeTree"
ENGINE_SORTING_KEY "flag_key, day, app, build_id, outcome, variation"

FORWARD_QUERY >
    SELECT *
