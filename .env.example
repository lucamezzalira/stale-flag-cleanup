# Tinybird
TINYBIRD_API_HOST=https://api.tinybird.co
TINYBIRD_TOKEN=
TINYBIRD_APPEND_TOKEN=

# Featurevisor datafile (local stand-in by default)
VITE_DATAFILE_URL=http://127.0.0.1:4099/production/featurevisor-all.json
DATAFILE_SERVE_PORT=4099
DATAFILE_S3_BUCKET=
DATAFILE_S3_PREFIX=featurevisor
DATAFILE_CLOUDFRONT_URL=
