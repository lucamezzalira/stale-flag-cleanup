# App / events
VITE_TINYBIRD_API_HOST=https://api.tinybird.co
VITE_TINYBIRD_APPEND_TOKEN=
VITE_BUILD_ID=dev.local
VITE_EVENT_FLUSH_MS=2000
VITE_EVENT_BATCH_SIZE=20

# Agent / Bedrock (surgeon in AWS + local)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_DISABLED=0
SCOUT_SOURCE=tinybird

# Optional local PR prose
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_DISABLED=1
GITHUB_TOKEN=
