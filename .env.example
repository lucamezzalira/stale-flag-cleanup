# App / events
VITE_TINYBIRD_API_HOST=https://api.tinybird.co
VITE_TINYBIRD_APPEND_TOKEN=
VITE_BUILD_ID=dev.local
VITE_EVENT_FLUSH_MS=2000
VITE_EVENT_BATCH_SIZE=20

# Agent / Ollama (surgeon only)
