# Tinybird (PoC workspace is often us-east AWS — adjust to your region host)
TINYBIRD_API_HOST=https://api.us-east.aws.tinybird.co

# REST read token for scout + surgeon harness (pipes: flag_candidates, cleanup_report, flag_safety_check)
TINYBIRD_TOKEN=
# Workspace admin (or .tinyb after `tb login`). Required to TRUNCATE before `pnpm seed`.
# CI verdict-parity uses GitHub secret TINYBIRD_ADMIN_TOKEN. Never ship this in the browser.
TINYBIRD_ADMIN_TOKEN=

# Scoped APPEND tokens (PRD-10). Copy values after `tb --cloud deploy` via:
#   tb --cloud --show-tokens token ls
# Do not reuse one token across writers.
TINYBIRD_BROWSER_EVENTS_TOKEN=   # browser_events → flag_evaluations, session_beacons
TINYBIRD_DEFS_TOKEN=             # defs_publisher → flag_definitions (CI publish-defs)
TINYBIRD_ADOPTION_TOKEN=         # adoption_writer → build_adoption (seed / release)
TINYBIRD_DECISION_TOKEN=         # decision_writer → cleanup_decision_log (scout/surgeon)

# Surgeon model evidence only: Tinybird MCP read on flag_safety_check + cleanup_report.
# After `tb --cloud deploy`, copy TOKEN surgeon_mcp_evidence (`tb --cloud --show-tokens token ls`).
# Do not reuse TINYBIRD_TOKEN. Empty => PR still opens with "Evidence narrative unavailable".
TINYBIRD_MCP_TOKEN=

# Featurevisor datafile (local stand-in by default)
VITE_DATAFILE_URL=http://127.0.0.1:4099/production/featurevisor-all.json
DATAFILE_SERVE_PORT=4099
DATAFILE_S3_BUCKET=
DATAFILE_S3_PREFIX=featurevisor
DATAFILE_CLOUDFRONT_URL=
AWS_REGION=us-east-1

# App / events (browser_events token ships in the public bundle by design)
VITE_TINYBIRD_API_HOST=https://api.us-east.aws.tinybird.co
VITE_TINYBIRD_BROWSER_EVENTS_TOKEN=
VITE_BUILD_ID=dev.local
VITE_EVENT_FLUSH_MS=2000
VITE_EVENT_BATCH_SIZE=20

# Agent / Bedrock (surgeon in AWS + local)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_DISABLED=0
SCOUT_SOURCE=tinybird

# Optional local PR prose
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_DISABLED=1
GITHUB_TOKEN=
GITHUB_REPO=lucamezzalira/stale-flag-cleanup
DEMO_BRANCH=demo

# Generator
SEED=42
SEED_DAYS=90
